include LICENSE
include README.md
include DATA_LICENSES.md
include THIRD_PARTY_NOTICES.md
include CONTRIBUTING.md
recursive-include docs/licenses *.json *.md
recursive-include docs/resource-data-bundle *.md *.txt
prune data
prune outputs
prune frontend/node_modules
prune frontend/dist
global-exclude .env .env.* .cdsapirc* *.grib *.xlsx *.xls *.xlsm *.csv *.db *.sqlite*
include data/reference/sh_to_wh_ratio.csv
include data/reference/slp_parameters.json
recursive-include configs *.toml
recursive-include templates *.html
recursive-include scripts *.py
recursive-include tests *.py *.json
